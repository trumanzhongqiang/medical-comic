  "learning_objectives": [
    "分清 LDL-C 和 HDL-C 各自负责哪个方向，为什么一个叫「坏」一个叫「好」",
    "知道 LDL-C 的达标值要按风险分层看，同一张单子对不同人意义不同",
    "了解查血脂的空腹要求、首次用药的复查时间点，以及生活方式干预的具体做法"
  ],
  "script": [
    "0-6.8 报告单上四个箭头，方向不一样",
    "6.8-13 胆固醇是身体的原料",
    "13-20.8 油不溶于血，要靠脂蛋白运",
    "20.8-28.6 LDL 从肝往外送",
    "28.6-34.9 HDL 把多余的运回肝",
    "34.9-41.1 送多了就留在管壁",
    "41.1-47.3 越堆越厚，管腔变窄",
    "47.3-53.6 该看的是 LDL-C",
    "53.6-66 LDL-C 目标按风险分层",
    "66-72.3 其余三项各有各的线",
    "72.3-81.6 空腹与复查时间点",
    "81.6-91 生活方式能做的事",
    "91-97.2 中等强度他汀起始",
    "97.2-116 三件事收尾"
  ],
