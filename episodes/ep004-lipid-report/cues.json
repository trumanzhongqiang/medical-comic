[
  {
    "t": 1.2,
    "end": 4.945,
    "text": "血脂报告一打开，上面列着四项。"
  },
  {
    "t": 5.545,
    "end": 8.531,
    "text": "排第三的，是低密度脂蛋白。"
  },
  {
    "t": 9.131,
    "end": 10.907,
    "text": "医生一般先看它。"
  },
  {
    "t": 11.507,
    "end": 15.448,
    "text": "因为把它降下来，心梗、脑梗会跟着少。"
  },
  {
    "t": 16.048,
    "end": 19.217,
    "text": "总胆固醇是个总数，好坏都算在里面。"
  },
  {
    "t": 19.817,
    "end": 21.281,
    "text": "胆固醇不溶于血。"
  },
  {
    "t": 21.881,
    "end": 24.882,
    "text": "它得装进一种颗粒里，才能被运走。"
  },
  {
    "t": 25.482,
    "end": 30.179,
    "text": "低密度脂蛋白，就是把胆固醇往外送的那一批。"
  },
  {
    "t": 30.779,
    "end": 33.743,
    "text": "高密度反过来，把用不完的运回肝里。"
  },
  {
    "t": 34.343,
    "end": 37.377,
    "text": "所以好坏不是两种胆固醇。"
  },
  {
    "t": 37.977,
    "end": 39.431,
    "text": "是两批颗粒。"
  },
  {
    "t": 40.031,
    "end": 42.843,
    "text": "低密度高，就是往外送多了。"
  },
  {
    "t": 43.443,
    "end": 47.21,
    "text": "多出来的会钻进血管壁，引起发炎。"
  },
  {
    "t": 47.81,
    "end": 50.946,
    "text": "慢慢长成斑块，血管就窄了。"
  },
  {
    "t": 51.546,
    "end": 56.117,
    "text": "所以低密度的目标没有一刀切，得看你的风险有多高。"
  },
  {
    "t": 56.717,
    "end": 60.433,
    "text": "得过心梗、脑梗的，要压到一点八以下。"
  },
  {
    "t": 61.033,
    "end": 64.496,
    "text": "只有高血压、糖尿病的，两点六以内。"
  },
  {
    "t": 65.096,
    "end": 68.075,
    "text": "风险低的，三点四以内。"
  },
  {
    "t": 68.675,
    "end": 74.651,
    "text": "甘油三酯是另一回事，跟喝酒、血糖高、体重超标关系更大。"
  },
  {
    "t": 75.251,
    "end": 79.14,
    "text": "超过一点七要留意，再高还要当心胰腺炎。"
  },
  {
    "t": 79.74,
    "end": 82.985,
    "text": "高密度高一点，通常是好事。"
  },
  {
    "t": 83.585,
    "end": 85.81,
    "text": "但抵消不了低密度。"
  },
  {
    "t": 86.41,
    "end": 89.498,
    "text": "先改吃：少肥肉、少油炸。"
  },
  {
    "t": 90.098,
    "end": 93.564,
    "text": "多吃蔬菜、全谷，还有深海鱼。"
  },
  {
    "t": 94.164,
    "end": 96.812,
    "text": "吃他汀的，别自己停。"
  }
]
