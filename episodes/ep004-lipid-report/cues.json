[
  {
    "t": 1.2,
    "end": 4.798,
    "text": "血脂报告一打开，上面列着四项。"
  },
  {
    "t": 5.398,
    "end": 8.863,
    "text": "真正的主角，是低密度和高密度。"
  },
  {
    "t": 9.463,
    "end": 14.452,
    "text": "总胆固醇是它们的总和，甘油三酯是另一回事。"
  },
  {
    "t": 15.052,
    "end": 16.896,
    "text": "胆固醇不溶于血。"
  },
  {
    "t": 17.496,
    "end": 20.762,
    "text": "它得装进一种颗粒里，才能被运走。"
  },
  {
    "t": 21.362,
    "end": 25.64,
    "text": "低密度脂蛋白，就是把胆固醇往外送的那一批。"
  },
  {
    "t": 26.24,
    "end": 29.984,
    "text": "高密度反过来，把用不完的运回肝里。"
  },
  {
    "t": 30.584,
    "end": 33.458,
    "text": "所以好坏不是两种胆固醇。"
  },
  {
    "t": 34.058,
    "end": 35.485,
    "text": "是两批颗粒。"
  },
  {
    "t": 36.085,
    "end": 39.13,
    "text": "低密度高，就是往外送多了。"
  },
  {
    "t": 39.73,
    "end": 42.973,
    "text": "多出来的会钻进血管壁，引起发炎。"
  },
  {
    "t": 43.573,
    "end": 46.633,
    "text": "慢慢长成斑块，血管就窄了。"
  },
  {
    "t": 47.233,
    "end": 51.928,
    "text": "所以低密度的目标没有一刀切，得看你的风险有多高。"
  },
  {
    "t": 52.528,
    "end": 56.322,
    "text": "得过心梗、脑梗的，要压到一点八以下。"
  },
  {
    "t": 56.922,
    "end": 60.552,
    "text": "只有高血压、糖尿病的，两点六以内。"
  },
  {
    "t": 61.152,
    "end": 63.81,
    "text": "风险低的，三点四以内。"
  },
  {
    "t": 64.41,
    "end": 66.685,
    "text": "回到这张单子，还有两项。"
  },
  {
    "t": 67.285,
    "end": 71.488,
    "text": "总胆固醇是三项加起来的总数，看不出好坏。"
  },
  {
    "t": 72.088,
    "end": 75.543,
    "text": "甘油三酯跟着喝酒、血糖、体重走。"
  },
  {
    "t": 76.143,
    "end": 79.755,
    "text": "超过一点七要留意，再高当心胰腺炎。"
  },
  {
    "t": 80.355,
    "end": 82.642,
    "text": "高密度高一点，是好事。"
  },
  {
    "t": 83.242,
    "end": 85.681,
    "text": "但它抵消不了低密度。"
  },
  {
    "t": 86.281,
    "end": 89.269,
    "text": "先改吃：少肥肉、少油炸。"
  },
  {
    "t": 89.869,
    "end": 92.64,
    "text": "多吃蔬菜、全谷，还有深海鱼。"
  },
  {
    "t": 93.24,
    "end": 95.347,
    "text": "吃他汀的，别自己停。"
  }
]
