  "beats": [
    {
      "id": "b00",
      "start": 0.0,
      "end": 6.789,
      "scene": "tired",
      "note": {
        "kind": "term",
        "title": "甲状腺",
        "body": "先别急着怪自己"
      },
      "cue": null,
      "subs": [
        {
          "t": 1.2,
          "end": 3.157,
          "text": "最近是不是老觉得累，",
          "c": 0,
          "ct": 1.2,
          "ce": 6.289
        },
        {
          "t": 3.157,
          "end": 4.919,
          "text": "什么都没干也没劲，",
          "c": 0,
          "ct": 1.2,
          "ce": 6.289
        },
        {
          "t": 4.919,
          "end": 6.289,
          "text": "还比别人怕冷。",
          "c": 0,
          "ct": 1.2,
          "ce": 6.289
        }
      ]
    },
    {
      "id": "b01",
      "start": 6.789,
      "end": 12.595,
      "scene": "report",
      "note": {
        "kind": "term",
        "title": "体检单上的它",
        "body": "甲功 + 彩超，是两件事"
      },
      "cue": null,
      "subs": [
        {
          "t": 6.989,
          "end": 9.031,
          "text": "体重还莫名其妙的往上涨。",
          "c": 0,
          "ct": 6.989,
          "ce": 12.095
        },
        {
          "t": 9.031,
          "end": 10.223,
          "text": "这不一定是胖，",
          "c": 0,
          "ct": 6.989,
          "ce": 12.095
        },
        {
          "t": 10.223,
          "end": 12.095,
          "text": "可能是甲状腺出了毛病。",
          "c": 0,
          "ct": 6.989,
          "ce": 12.095
        }
      ]
    },
    {
      "id": "b02",
      "start": 12.595,
      "end": 20.622,
      "scene": "signs-hyper",
      "note": {
        "kind": "term",
        "title": "甲亢",
        "accent": true,
        "body": "激素长期高于正常"
      },
      "cue": null,
      "subs": [
        {
          "t": 12.795,
          "end": 16.027,
          "text": "也有人正好反过来：饭量变大了，",
          "c": 0,
          "ct": 12.795,
          "ce": 20.122
        },
        {
          "t": 16.027,
          "end": 18.829,
          "text": "人却越来越瘦，心慌、出汗，",
          "c": 0,
          "ct": 12.795,
          "ce": 20.122
        },
        {
          "t": 18.829,
          "end": 20.122,
          "text": "手端碗会抖。",
          "c": 0,
          "ct": 12.795,
          "ce": 20.122
        }
      ]
    },
    {
      "id": "b03",
      "start": 20.622,
      "end": 28.397,
      "scene": "split",
      "note": {
        "kind": "term",
        "title": "同一个腺体",
        "body": "两种完全相反的表现"
      },
      "cue": null,
      "subs": [
        {
          "t": 20.822,
          "end": 23.117,
          "text": "这两种人看着完全不一样，",
          "c": 0,
          "ct": 20.822,
          "ce": 27.897
        },
        {
          "t": 23.117,
          "end": 25.029,
          "text": "毛病却在同一个地方，",
          "c": 0,
          "ct": 20.822,
          "ce": 27.897
        },
        {
          "t": 25.029,
          "end": 27.897,
          "text": "就是脖子前面那块叫甲状腺的肉。",
          "c": 0,
          "ct": 20.822,
          "ce": 27.897
        }
      ]
    },
    {
      "id": "b04",
      "start": 28.397,
      "end": 39.852,
      "scene": "neck",
      "note": {
        "kind": "term",
        "title": "位置",
        "body": "喉结往下、气管两旁"
      },
      "cue": null,
      "subs": [
        {
          "t": 28.597,
          "end": 31.755,
          "text": "你摸自己的喉结，往下一点点，",
          "c": 0,
          "ct": 28.597,
          "ce": 34.01
        },
        {
          "t": 31.755,
          "end": 34.01,
          "text": "气管的两边，就是它。",
          "c": 0,
          "ct": 28.597,
          "ce": 34.01
        },
        {
          "t": 34.71,
          "end": 37.363,
          "text": "正常的时候它很软、很薄，",
          "c": 1,
          "ct": 34.71,
          "ce": 39.352
        },
        {
          "t": 37.363,
          "end": 39.352,
          "text": "用手是摸不出来的。",
          "c": 1,
          "ct": 34.71,
          "ce": 39.352
        }
      ]
    },
    {
      "id": "b05",
      "start": 39.852,
      "end": 47.539,
      "scene": "where",
      "note": {
        "kind": "term",
        "title": "蝴蝶形",
        "body": "左右两叶 + 中间峡部"
      },
      "cue": null,
      "subs": [
        {
          "t": 40.052,
          "end": 41.58,
          "text": "它分左右两片，",
          "c": 0,
          "ct": 40.052,
          "ce": 47.039
        },
        {
          "t": 41.58,
          "end": 44.201,
          "text": "中间有一条窄的连在一起，",
          "c": 0,
          "ct": 40.052,
          "ce": 47.039
        },
        {
          "t": 44.201,
          "end": 47.039,
          "text": "形状像一只张开翅膀的蝴蝶。",
          "c": 0,
          "ct": 40.052,
          "ce": 47.039
        }
      ]
    },
    {
      "id": "b06",
      "start": 47.539,
      "end": 52.371,
      "scene": "size",
      "note": {
        "kind": "none"
      },
      "cue": null,
      "subs": [
        {
          "t": 47.739,
          "end": 50.218,
          "text": "整个加起来也就二十来克，",
          "c": 0,
          "ct": 47.739,
          "ce": 51.871
        },
        {
          "t": 50.218,
          "end": 51.871,
          "text": "比一个鸡蛋还轻。",
          "c": 0,
          "ct": 47.739,
          "ce": 51.871
        }
      ]
    },
    {
      "id": "b07",
      "start": 52.371,
      "end": 69.262,
      "scene": "systemic",
      "note": {
        "kind": "term",
        "title": "管全身快慢",
        "body": "激素就是它发的指令"
      },
      "cue": null,
      "subs": [
        {
          "t": 52.571,
          "end": 53.774,
          "text": "别看它这么小，",
          "c": 0,
          "ct": 52.571,
          "ce": 55.493
        },
        {
          "t": 53.774,
          "end": 55.493,
          "text": "全身的快慢都归它管。",
          "c": 0,
          "ct": 52.571,
          "ce": 55.493
        },
        {
          "t": 56.193,
          "end": 59.088,
          "text": "它分泌的激素跟着血走遍全身，",
          "c": 1,
          "ct": 56.193,
          "ce": 63.018
        },
        {
          "t": 59.088,
          "end": 61.57,
          "text": "告诉每个器官：该快一点，",
          "c": 1,
          "ct": 56.193,
          "ce": 63.018
        },
        {
          "t": 61.57,
          "end": 63.018,
          "text": "还是该慢一点。",
          "c": 1,
          "ct": 56.193,
          "ce": 63.018
        },
        {
          "t": 63.718,
          "end": 65.82,
          "text": "心跳快慢、身上冷暖、",
          "c": 2,
          "ct": 63.718,
          "ce": 68.762
        },
        {
          "t": 65.82,
          "end": 68.762,
          "text": "人是精神还是犯困，都听它的。",
          "c": 2,
          "ct": 63.718,
          "ce": 68.762
        }
      ]
    },
    {
      "id": "b08",
      "start": 69.262,
      "end": 74.931,
      "scene": "pedal",
      "note": {
        "kind": "term",
        "title": "油门",
        "body": "激素 = 踩下去的那股劲"
      },
      "cue": null,
      "subs": [
        {
          "t": 69.462,
          "end": 71.854,
          "text": "你可以把它想成汽车的油门，",
          "c": 0,
          "ct": 69.462,
          "ce": 74.431
        },
        {
          "t": 71.854,
          "end": 74.431,
          "text": "激素就是油门踩下去的那股劲。",
          "c": 0,
          "ct": 69.462,
          "ce": 74.431
        }
      ]
    },
    {
      "id": "b09",
      "start": 74.931,
      "end": 80.729,
      "scene": "pedal-gentle",
      "note": {
        "kind": "term",
        "title": "踩深踩浅",
        "body": "全身跟着快慢"
      },
      "cue": null,
      "subs": [
        {
          "t": 75.131,
          "end": 78.456,
          "text": "油门踩得深，车跑得快；踩得浅，",
          "c": 0,
          "ct": 75.131,
          "ce": 80.229
        },
        {
          "t": 78.456,
          "end": 80.229,
          "text": "车就慢吞吞地走。",
          "c": 0,
          "ct": 75.131,
          "ce": 80.229
        }
      ]
    },
    {
      "id": "b10",
